// KISS VTMP data model (TAD §6): every R1 core entity plus the R2 competency, passport and
// intervention tables. R3 tables (job roles, evidence, AI materials) arrive in Sprint 11/12.
//
// Conventions: UUID keys, snake_case tables/columns, every foreign key indexed.
// Constraints Prisma cannot express (CHECKs, partial unique indexes, triggers) live in the
// raw SQL at the end of the matching migration; see docs/ER.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (mirror packages/shared/src/enums) ──────────────────────────────────

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

enum Locale {
  en
  or
  hi
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  ALLOCATED
  ACTIVE
  COMPLETED
  NOT_COMPLETED
  CERTIFIED
  WITHDRAWN
}

enum BatchStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum SessionStatus {
  SCHEDULED
  CONDUCTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AssessmentMode {
  THEORY
  PRACTICAL
}

enum CertificateStatus {
  VALID
  REVOKED
  SUPERSEDED
}

enum Grade {
  A
  B
  C
  D
  NOT_COMPLETED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum InterventionActionType {
  COUNSELLING
  EXTRA_SESSION
  PRACTICE_TASK
}

enum OpportunityType {
  INTERNSHIP
  APPRENTICESHIP
  JOB
}

enum EvidenceKind {
  FILE
  LINK
}

enum PlacementType {
  JOB
  APPRENTICESHIP
  INTERNSHIP
  SELF_EMPLOYED
  FURTHER_STUDY
}

enum MaterialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LearningResourceType {
  VIDEO
  DOCUMENT
  PRACTICE_TASK
  REMEDIAL_SESSION
}

// ─── Identity and access ───────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  role               Role
  locale             Locale    @default(en)
  isActive           Boolean   @default(true) @map("is_active")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Set when an admin chose the password (new account or reset); cleared when the user changes it.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student       Student?
  trainer       Trainer?
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
  idempotency   IdempotencyKey[]

  enrollmentDecisions  Enrollment[]         @relation("EnrollmentDecidedBy")
  attendanceMarked     Attendance[]         @relation("AttendanceMarkedBy")
  progressRecorded     Progress[]           @relation("ProgressRecordedBy")
  assessmentsCreated   Assessment[]         @relation("AssessmentCreatedBy")
  resultsRecorded      AssessmentResult[]   @relation("ResultRecordedBy")
  evaluations          Evaluation[]         @relation("EvaluationBy")
  certificatesIssued   Certificate[]        @relation("CertificateIssuedBy")
  reportsGenerated     PerformanceReport[]  @relation("ReportGeneratedBy")
  settingsUpdated      Setting[]            @relation("SettingUpdatedBy")
  ratingsGiven         CompetencyRating[]   @relation("RatingRatedBy")
  ratingsVerified      CompetencyRating[]   @relation("RatingVerifiedBy")
  ratingsRevoked       CompetencyRating[]   @relation("RatingRevokedBy")
  resourcesCreated     LearningResource[]   @relation("ResourceCreatedBy")
  resourcesApproved    LearningResource[]   @relation("ResourceApprovedBy")
  interventionsOwned   InterventionAction[] @relation("ActionOwner")
  interventionsCreated InterventionAction[] @relation("ActionCreatedBy")

  evidenceUploaded     PracticalEvidence[] @relation("EvidenceUploadedBy")
  rubricsCreated       Rubric[]            @relation("RubricCreatedBy")
  opportunitiesCreated Opportunity[]       @relation("OpportunityCreatedBy")

  placementsRecorded PlacementOutcome[] @relation("PlacementRecordedBy")

  materialsUploaded Material[]     @relation("MaterialUploadedBy")
  materialsApproved Material[]     @relation("MaterialApprovedBy")
  assistantLogs     AssistantLog[]

  @@index([role])
  @@map("users")
}

/// Refresh tokens are stored as SHA-256 hashes only. A family shares one familyId so reuse of
/// a rotated token can revoke every descendant (Sprint 2).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Student {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  rollNo    String   @unique @map("roll_no")
  cgpa      Decimal  @db.Decimal(4, 2)
  phone     String?
  photoUrl  String?  @map("photo_url")
  /// Optional name in Odia script, printed under the English name on certificates (BRQ-16.2).
  nameOdia  String?  @map("name_odia")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollments       Enrollment[]
  batchMemberships  BatchStudent[]
  attendance        Attendance[]
  progress          Progress[]
  results           AssessmentResult[]
  competencyRatings CompetencyRating[]
  passportShares    PassportShare[]
  riskFlags         RiskFlag[]

  opportunityInterests OpportunityInterest[]

  @@map("students")
}

model Trainer {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  employeeCode   String   @unique @map("employee_code")
  phone          String?
  specialization String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments TrainerAssignment[]
  sessions    TrainingSession[]

  @@map("trainers")
}

// ─── Courses and enrollment (F2, F3) ───────────────────────────────────────────

model Course {
  id                      String   @id @default(uuid()) @db.Uuid
  code                    String   @unique
  title                   String
  description             String
  durationWeeks           Int      @map("duration_weeks")
  prerequisites           String?
  /// Automatic approval holds applications naming this course for a person while true.
  prerequisitesNeedReview Boolean  @default(true) @map("prerequisites_need_review")
  seatCapacity            Int      @map("seat_capacity")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  offerings    CourseOffering[]
  preferences  EnrollmentPreference[]
  batches      Batch[]
  competencies Competency[]

  materials Material[]

  @@index([isActive])
  @@map("courses")
}

model TrainingCycle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  offerings   CourseOffering[]
  enrollments Enrollment[]
  batches     Batch[]

  @@map("training_cycles")
}

/// A course offered in a cycle, with its elective enrollment window (BRQ-2.3, BR-02).
model CourseOffering {
  id                 String   @id @default(uuid()) @db.Uuid
  courseId           String   @map("course_id") @db.Uuid
  cycleId            String   @map("cycle_id") @db.Uuid
  enrollmentOpensAt  DateTime @map("enrollment_opens_at") @db.Timestamptz(3)
  enrollmentClosesAt DateTime @map("enrollment_closes_at") @db.Timestamptz(3)
  isOpen             Boolean  @default(false) @map("is_open")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cycle  TrainingCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)

  @@unique([courseId, cycleId])
  @@index([cycleId])
  @@map("course_offerings")
}

/// One application per student per cycle. BR-01 (one *active* enrollment) is a partial unique
/// index in SQL: rejected and not-completed enrollments do not block a new one.
model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  cycleId     String           @map("cycle_id") @db.Uuid
  status      EnrollmentStatus @default(PENDING)
  reason      String?
  submittedAt DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt   DateTime?        @map("decided_at") @db.Timestamptz(3)
  decidedById String?          @map("decided_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student            Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  cycle              TrainingCycle          @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  decidedBy          User?                  @relation("EnrollmentDecidedBy", fields: [decidedById], references: [id])
  preferences        EnrollmentPreference[]
  batchMembership    BatchStudent?
  evaluation         Evaluation?
  certificates       Certificate[]
  performanceReports PerformanceReport[]

  // Target for BatchStudent's composite FK, so a membership's student always matches.
  placements PlacementOutcome[]

  @@unique([id, studentId])
  @@index([studentId])
  @@index([cycleId, status])
  @@index([decidedById])
  @@map("enrollments")
}

model EnrollmentPreference {
  id           String @id @default(uuid()) @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid
  courseId     String @map("course_id") @db.Uuid
  rank         Int

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, rank])
  @@unique([enrollmentId, courseId])
  @@index([courseId])
  @@map("enrollment_preferences")
}

// ─── Batches and sessions (F4) ─────────────────────────────────────────────────

model Batch {
  id        String      @id @default(uuid()) @db.Uuid
  courseId  String      @map("course_id") @db.Uuid
  cycleId   String      @map("cycle_id") @db.Uuid
  name      String
  capacity  Int
  startDate DateTime    @map("start_date") @db.Date
  endDate   DateTime    @map("end_date") @db.Date
  venue     String
  status    BatchStatus @default(PLANNED)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  course            Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cycle             TrainingCycle       @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  students          BatchStudent[]
  trainers          TrainerAssignment[]
  sessions          TrainingSession[]
  assessments       Assessment[]
  progress          Progress[]
  competencyRatings CompetencyRating[]
  riskFlags         RiskFlag[]

  @@unique([courseId, cycleId, name])
  @@index([cycleId, status])
  @@map("batches")
}

/// Allocation of an enrollment to a batch. One batch per enrollment; studentId is carried for
/// fast roster queries and kept consistent by the composite FK to enrollments(id, student_id).
model BatchStudent {
  id           String   @id @default(uuid()) @db.Uuid
  batchId      String   @map("batch_id") @db.Uuid
  enrollmentId String   @unique @map("enrollment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  allocatedAt  DateTime @default(now()) @map("allocated_at") @db.Timestamptz(3)

  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId, studentId], references: [id, studentId], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([batchId, studentId])
  @@unique([enrollmentId, studentId])
  @@index([studentId])
  @@map("batch_students")
}

model TrainerAssignment {
  batchId    String   @map("batch_id") @db.Uuid
  trainerId  String   @map("trainer_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@id([batchId, trainerId])
  @@index([trainerId])
  @@map("trainer_assignments")
}

model TrainingSession {
  id        String        @id @default(uuid()) @db.Uuid
  batchId   String        @map("batch_id") @db.Uuid
  trainerId String?       @map("trainer_id") @db.Uuid
  startsAt  DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime      @map("ends_at") @db.Timestamptz(3)
  venue     String
  topic     String?
  status    SessionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  trainer    Trainer?     @relation(fields: [trainerId], references: [id])
  attendance Attendance[]

  @@index([batchId, startsAt])
  @@index([trainerId, startsAt])
  @@index([venue, startsAt])
  @@map("training_sessions")
}

// ─── Attendance, assessment, evaluation (F5, F6) ───────────────────────────────

/// firstMarkedAt anchors the 48 h trainer edit window (BR-06); markedAt is the latest edit.
model Attendance {
  id            String           @id @default(uuid()) @db.Uuid
  sessionId     String           @map("session_id") @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  status        AttendanceStatus
  markedById    String           @map("marked_by_id") @db.Uuid
  firstMarkedAt DateTime         @default(now()) @map("first_marked_at") @db.Timestamptz(3)
  markedAt      DateTime         @default(now()) @map("marked_at") @db.Timestamptz(3)

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  markedBy User            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId, sessionId])
  @@index([markedById])
  @@map("attendance")
}

/// Progress milestone for one student in a batch, or for the whole batch when studentId is null.
model Progress {
  id           String   @id @default(uuid()) @db.Uuid
  batchId      String   @map("batch_id") @db.Uuid
  studentId    String?  @map("student_id") @db.Uuid
  milestone    String
  note         String?
  recordedById String   @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy User     @relation("ProgressRecordedBy", fields: [recordedById], references: [id])

  @@index([batchId])
  @@index([studentId])
  @@index([recordedById])
  @@map("progress")
}

model Assessment {
  id          String         @id @default(uuid()) @db.Uuid
  batchId     String         @map("batch_id") @db.Uuid
  title       String
  mode        AssessmentMode
  maxMarks    Decimal        @map("max_marks") @db.Decimal(6, 2)
  weightage   Decimal        @db.Decimal(6, 2)
  isMandatory Boolean        @default(false) @map("is_mandatory")
  heldOn      DateTime?      @map("held_on") @db.Date
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  batch        Batch                  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdBy    User                   @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  results      AssessmentResult[]
  competencies AssessmentCompetency[]

  rubric Rubric?

  @@index([batchId])
  @@index([createdById])
  @@map("assessments")
}

/// BR-07: 0 <= marks <= assessments.max_marks, enforced by a trigger.
model AssessmentResult {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  marks        Decimal  @db.Decimal(6, 2)
  remarks      String?
  recordedById String   @map("recorded_by_id") @db.Uuid
  recordedAt   DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy User       @relation("ResultRecordedBy", fields: [recordedById], references: [id])

  evidence PracticalEvidence[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([recordedById])
  @@map("assessment_results")
}

/// Final trainer evaluation with the completion recommendation (BR-09).
model Evaluation {
  id            String   @id @default(uuid()) @db.Uuid
  enrollmentId  String   @unique @map("enrollment_id") @db.Uuid
  remarks       String
  recommended   Boolean
  evaluatedById String   @map("evaluated_by_id") @db.Uuid
  evaluatedAt   DateTime @default(now()) @map("evaluated_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment  Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  evaluatedBy User       @relation("EvaluationBy", fields: [evaluatedById], references: [id])

  @@index([evaluatedById])
  @@map("evaluations")
}

// ─── Certificates and reports (F7, F8, F15) ────────────────────────────────────

/// Snapshots (grade, aggregate, attendance) are frozen at issue. Only one VALID certificate
/// per enrollment (partial unique index); reissue marks the old one SUPERSEDED.
model Certificate {
  id                String            @id @default(uuid()) @db.Uuid
  enrollmentId      String            @map("enrollment_id") @db.Uuid
  publicCode        String            @unique @map("public_code")
  status            CertificateStatus @default(VALID)
  grade             Grade
  aggregatePercent  Decimal           @map("aggregate_percent") @db.Decimal(5, 2)
  attendancePercent Decimal           @map("attendance_percent") @db.Decimal(5, 2)
  issuedAt          DateTime          @default(now()) @map("issued_at") @db.Timestamptz(3)
  issuedById        String            @map("issued_by_id") @db.Uuid
  revokedAt         DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?           @map("revoked_reason")
  supersededById    String?           @unique @map("superseded_by_id") @db.Uuid
  verificationCount Int               @default(0) @map("verification_count")
  pdfObjectKey      String?           @map("pdf_object_key")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  issuedBy     User         @relation("CertificateIssuedBy", fields: [issuedById], references: [id])
  supersededBy Certificate? @relation("CertificateSupersession", fields: [supersededById], references: [id])
  supersedes   Certificate? @relation("CertificateSupersession")

  @@index([enrollmentId])
  @@index([status])
  @@index([issuedById])
  @@map("certificates")
}

model PerformanceReport {
  id            String   @id @default(uuid()) @db.Uuid
  enrollmentId  String   @map("enrollment_id") @db.Uuid
  snapshot      Json
  pdfObjectKey  String?  @map("pdf_object_key")
  generatedById String   @map("generated_by_id") @db.Uuid
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  enrollment  Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  generatedBy User       @relation("ReportGeneratedBy", fields: [generatedById], references: [id])

  @@index([enrollmentId])
  @@index([generatedById])
  @@map("performance_reports")
}

// ─── Kernel: audit, notifications, idempotency, settings ───────────────────────

/// Insert-only (NFR-06): a trigger rejects UPDATE, DELETE and TRUNCATE. userId is null for
/// system actions (cron jobs).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  /// Parameters for the client to render the message in the user's language (type is the i18n key).
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Stored response for an Idempotency-Key, replayed when the same user retries the same route.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  key            String
  userId         String   @map("user_id") @db.Uuid
  route          String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Configurable thresholds (CLAUDE.md rule 4). Keys and value types are defined in
/// apps/api/src/core/settings/registry.ts.
model Setting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([updatedById])
  @@map("settings")
}

// ─── R2: competency model, passport, intervention (F10, F11, F12) ──────────────

model Competency {
  id            String         @id @default(uuid()) @db.Uuid
  courseId      String         @map("course_id") @db.Uuid
  code          String
  title         String
  description   String?
  mode          AssessmentMode
  requiredLevel Int            @map("required_level")
  isMandatory   Boolean        @default(false) @map("is_mandatory")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  assessments AssessmentCompetency[]
  ratings     CompetencyRating[]
  resources   LearningResource[]

  evidence PracticalEvidence[]

  @@unique([courseId, code])
  @@map("competencies")
}

model AssessmentCompetency {
  assessmentId String @map("assessment_id") @db.Uuid
  competencyId String @map("competency_id") @db.Uuid

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([assessmentId, competencyId])
  @@index([competencyId])
  @@map("assessment_competencies")
}

/// Trainer rating 1–4. Verified when level >= required and an assigned trainer confirms
/// (BR-13). Verified ratings are never deleted, only revoked with a reason (BR-14).
model CompetencyRating {
  id            String    @id @default(uuid()) @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  competencyId  String    @map("competency_id") @db.Uuid
  batchId       String    @map("batch_id") @db.Uuid
  level         Int
  ratedById     String    @map("rated_by_id") @db.Uuid
  ratedAt       DateTime  @default(now()) @map("rated_at") @db.Timestamptz(3)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(3)
  verifiedById  String?   @map("verified_by_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedReason String?   @map("revoked_reason")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  ratedBy    User       @relation("RatingRatedBy", fields: [ratedById], references: [id])
  verifiedBy User?      @relation("RatingVerifiedBy", fields: [verifiedById], references: [id])
  revokedBy  User?      @relation("RatingRevokedBy", fields: [revokedById], references: [id])

  @@unique([studentId, competencyId, batchId])
  @@index([competencyId])
  @@index([batchId])
  @@index([ratedById])
  @@index([verifiedById])
  @@index([revokedById])
  @@map("competency_ratings")
}

model LearningResource {
  id           String               @id @default(uuid()) @db.Uuid
  competencyId String               @map("competency_id") @db.Uuid
  title        String
  type         LearningResourceType
  url          String
  createdById  String               @map("created_by_id") @db.Uuid
  approvedById String?              @map("approved_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("ResourceCreatedBy", fields: [createdById], references: [id])
  approvedBy User?      @relation("ResourceApprovedBy", fields: [approvedById], references: [id])

  @@index([competencyId])
  @@index([createdById])
  @@index([approvedById])
  @@map("learning_resources")
}

/// Shareable read-only passport link. Only the SHA-256 of the 32-byte token is stored.
model PassportShare {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at") @db.Timestamptz(3)

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@map("passport_shares")
}

/// One open flag per (student, batch) via a partial unique index; closed flags stay as history.
/// clearSince marks when all triggers last cleared (BR-17 closes after 7 clear days).
model RiskFlag {
  id          String    @id @default(uuid()) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  batchId     String    @map("batch_id") @db.Uuid
  level       RiskLevel
  reasons     Json
  openedAt    DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  clearSince  DateTime? @map("clear_since") @db.Timestamptz(3)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(3)
  escalatedAt DateTime? @map("escalated_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  batch   Batch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actions InterventionAction[]

  @@index([studentId])
  @@index([batchId, level])
  @@map("risk_flags")
}

model InterventionAction {
  id          String                 @id @default(uuid()) @db.Uuid
  flagId      String                 @map("flag_id") @db.Uuid
  type        InterventionActionType
  ownerId     String                 @map("owner_id") @db.Uuid
  dueOn       DateTime               @map("due_on") @db.Date
  note        String?
  outcome     String?
  completedAt DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdById String                 @map("created_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  flag      RiskFlag @relation(fields: [flagId], references: [id], onDelete: Restrict)
  owner     User     @relation("ActionOwner", fields: [ownerId], references: [id])
  createdBy User     @relation("ActionCreatedBy", fields: [createdById], references: [id])

  @@index([flagId])
  @@index([ownerId])
  @@index([createdById])
  @@map("intervention_actions")
}

// ─── Infrastructure ────────────────────────────────────────────────────────────

/// Fixed-window rate-limit counters shared by every serverless instance (Vercel has no shared
/// memory). Keys are hashed (no raw IPs stored); expired rows are pruned opportunistically.
model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limits")
}

/// Lease for scheduled jobs (Sprint 10). Session advisory locks don't survive the pooled
/// (PgBouncer transaction mode) Neon URL, so a run claims this row atomically instead.
model JobLock {
  name          String    @id
  runId         String    @map("run_id") @db.Uuid
  lockedUntil   DateTime  @map("locked_until") @db.Timestamptz(3)
  lastRunAt     DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastResult    Json?     @map("last_result")

  @@map("job_locks")
}

/// Allocation preview snapshot (Sprint 4). Kept in the database because serverless instances
/// share no memory. Confirm recomputes `fingerprint` and refuses if anything changed since.
model AllocationPreview {
  id          String    @id @default(uuid()) @db.Uuid
  cycleId     String    @map("cycle_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  fingerprint String
  result      Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)

  @@index([cycleId])
  @@index([expiresAt])
  @@map("allocation_previews")
}

// ─── R3: practical evidence (F18), career matcher (F13) ─────────────────────────

/// BRQ-18.2: named criteria scored on levels, attached to one practical assessment.
model Rubric {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @unique @map("assessment_id") @db.Uuid
  /// [{ key, name, description? }]
  criteria     Json
  /// [{ value, label }] in ascending order
  levels       Json
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("RubricCreatedBy", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("rubrics")
}

/// BRQ-18.1, 18.3: a file (object storage, ADR-10) or a video link proving a practical result.
model PracticalEvidence {
  id           String       @id @default(uuid()) @db.Uuid
  resultId     String       @map("result_id") @db.Uuid
  competencyId String?      @map("competency_id") @db.Uuid
  kind         EvidenceKind
  /// FILE: server-generated storage key; the file itself never enters the database.
  objectKey    String?      @unique @map("object_key")
  /// LINK: an https video link (videos are links only, NFR-14).
  url          String?
  fileName     String?      @map("file_name")
  mime         String?
  sizeBytes    Int?         @map("size_bytes")
  /// Rubric scores { criterionKey: level }.
  scores       Json?
  note         String?
  uploadedById String       @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  result     AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  competency Competency?      @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  uploadedBy User             @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])

  @@index([resultId])
  @@index([competencyId])
  @@index([uploadedById])
  @@map("practical_evidence")
}

/// BRQ-C.3: a job role defined by required competency codes and levels.
model JobRole {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  competencies  JobRoleCompetency[]
  opportunities Opportunity[]

  @@map("job_roles")
}

model JobRoleCompetency {
  roleId         String @map("role_id") @db.Uuid
  competencyCode String @map("competency_code")
  level          Int

  role JobRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, competencyCode])
  @@map("job_role_competencies")
}

/// BRQ-13.1: an internship, apprenticeship or job for a role, from a partner.
model Opportunity {
  id          String          @id @default(uuid()) @db.Uuid
  roleId      String          @map("role_id") @db.Uuid
  title       String
  type        OpportunityType
  partner     String
  location    String?
  description String?
  closesOn    DateTime        @map("closes_on") @db.Date
  isActive    Boolean         @default(true) @map("is_active")
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  role      JobRole               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy User                  @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  interests OpportunityInterest[]

  placements PlacementOutcome[]

  @@index([roleId])
  @@index([closesOn])
  @@index([createdById])
  @@map("opportunities")
}

/// BRQ-13.4: a student's interest in an opportunity (one per student).
model OpportunityInterest {
  opportunityId String   @map("opportunity_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([opportunityId, studentId])
  @@index([studentId])
  @@map("opportunity_interests")
}

// ─── R3: outcome analytics (F20) ─────────────────────────────────────────────────

/// BRQ-20.3: what a student did after training (entered by the admin / placement cell).
/// The analytics materialized views (analytics_batch_outcomes, analytics_course_competency)
/// are defined in SQL migrations, not here: Prisma does not model views it cannot write.
model PlacementOutcome {
  id            String        @id @default(uuid()) @db.Uuid
  enrollmentId  String        @map("enrollment_id") @db.Uuid
  opportunityId String?       @map("opportunity_id") @db.Uuid
  type          PlacementType
  employer      String
  roleTitle     String        @map("role_title")
  placedOn      DateTime      @map("placed_on") @db.Date
  monthlyIncome Decimal?      @map("monthly_income") @db.Decimal(10, 2)
  notes         String?
  recordedById  String        @map("recorded_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment  Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  recordedBy  User         @relation("PlacementRecordedBy", fields: [recordedById], references: [id])

  @@index([enrollmentId])
  @@index([opportunityId])
  @@index([recordedById])
  @@map("placement_outcomes")
}

// ─── R3: AI Training Assistant (F17, ADR-09; off unless AI_ENABLED) ─────────────

/// A course material an admin uploaded (PDF or text). Only APPROVED materials are chunked,
/// embedded and searchable (BR-21: answers come only from approved materials).
model Material {
  id           String         @id @default(uuid()) @db.Uuid
  courseId     String         @map("course_id") @db.Uuid
  title        String
  objectKey    String         @unique @map("object_key")
  mime         String
  sizeBytes    Int            @map("size_bytes")
  status       MaterialStatus @default(PENDING)
  chunkCount   Int            @default(0) @map("chunk_count")
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  approvedById String?        @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?      @map("approved_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  course     Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  uploadedBy User            @relation("MaterialUploadedBy", fields: [uploadedById], references: [id])
  approvedBy User?           @relation("MaterialApprovedBy", fields: [approvedById], references: [id])
  chunks     MaterialChunk[]

  @@index([courseId, status])
  @@index([uploadedById])
  @@index([approvedById])
  @@map("materials")
}

/// ~500-token excerpt of an approved material with its embedding (pgvector, cosine index).
model MaterialChunk {
  id         String                      @id @default(uuid()) @db.Uuid
  materialId String                      @map("material_id") @db.Uuid
  ordinal    Int
  content    String
  tokenCount Int                         @map("token_count")
  embedding  Unsupported("vector(1024)")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, ordinal])
  @@map("material_chunks")
}

/// One assistant request: what was asked, which excerpts were used, cost and outcome
/// (BRQ-17.5). Never the student's name or contact details.
model AssistantLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  mode           String
  question       String
  chunkIds       String[] @map("chunk_ids") @db.Uuid
  bestSimilarity Float?   @map("best_similarity")
  refused        Boolean  @default(false)
  refusalReason  String?  @map("refusal_reason")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  latencyMs      Int      @default(0) @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("assistant_logs")
}
