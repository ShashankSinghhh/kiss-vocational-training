# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Proxies in front of the API in production (1 on Vercel)
TRUST_PROXY_HOPS=1
# Named (security) rate limits: memory | postgres. Default: postgres in production, memory otherwise
# RATE_LIMIT_STORE=memory

# PostgreSQL (docker compose `pnpm db:up` uses these credentials)
DATABASE_URL=postgresql://vtmp:vtmp@localhost:5432/vtmp?schema=public
TEST_DATABASE_URL=postgresql://vtmp:vtmp@localhost:5432/vtmp_test?schema=public
# Production only (Vercel): direct, non-pooled Neon URL used by migrations in the build
# DIRECT_DATABASE_URL=

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-dev-only-access-secret-at-least-32-chars
REFRESH_SECRET=change-me-dev-only-refresh-secret-at-least-32-chars
# bcrypt cost: TAD §9 requires 12 (never below 10 outside tests)
BCRYPT_ROUNDS=12

# Public base URL used in certificate QR codes. Fix it before the first deploy and never change it.
PUBLIC_BASE_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Request limit for the whole API per 15 minutes (flood protection; default 1000). Counted per
# signed-in user, or per IP for anonymous requests, so a lab sharing one campus IP is not blocked.
# GLOBAL_RATE_LIMIT_PER_15MIN=1000

# File storage: local disk in dev (git-ignored ./storage), private Vercel Blob in production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Production: STORAGE_DRIVER=vercel-blob; Vercel adds BLOB_READ_WRITE_TOKEN when a Blob store
# is connected to the project (docs/internal/DEPLOYMENT.md).
BLOB_READ_WRITE_TOKEN=

# Scheduled jobs (Sprint 10). Production: Vercel Cron calls /api/v1/internal/jobs/risk-evaluation
# with this as a Bearer token (Vercel sends it automatically when CRON_SECRET is set on the
# project). Locally node-cron runs the job at 02:00, so leave it empty. 16+ random characters.
CRON_SECRET=

# AI Training Assistant (Release 3, off by default)
AI_ENABLED=false
ANTHROPIC_API_KEY=
# US dollars per calendar month; 0 keeps the assistant closed even when enabled.
AI_MONTHLY_CAP=0
AI_MODEL=claude-haiku-5-5
# claude (needs ANTHROPIC_API_KEY) or mock (no model; development and e2e only)
ASSISTANT_PROVIDER=claude
# Material search embeddings: mock locally; voyage (needs VOYAGE_API_KEY) in production.
EMBEDDING_PROVIDER=mock
VOYAGE_API_KEY=

# Web (Vite exposes only VITE_* variables to the browser)
VITE_API_BASE_URL=/api/v1
